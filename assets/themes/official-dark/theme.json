{
  "schemaVersion": 1,
  "id": "official.dark",
  "name": "Robyne 暗色",
  "author": "Robyne",
  "authorUrl": "https://github.com/robyne",
  "version": "1.0.0",
  "description": "官方暗色皮肤。低对比、护眼，适合夜间使用。",
  "preview": "#0E0F12",
  "tags": [
    "dark",
    "minimalist"
  ],
  "mode": "dark",
  "tokens": {
    "color": {
      "background": {
      "base": "#0E0F12",
        "elevated": "#15171B",
        "sunken": "#0A0B0D",
        "overlay": "#99000000"
      },
      "surface": {
        "base": "#1A1D21",
        "hover": "#22262B",
        "active": "#2A2F35",
        "selected": "#2E211D"
      },
      "brand": {
        "base": "#FF6B4A",
        "hover": "#FF8570",
        "muted": "#33FF6B4A",
        "onBrand": "#141517"
      },
      "accent": {
        "base": "#5AD0BE",
        "muted": "#245A50",
        "onAccent": "#0E0F12"
      },
      "text": {
        "primary": "#F2F3F5",
        "secondary": "#A9AEB6",
        "muted": "#6E737B",
        "disabled": "#4A4E55"
      },
      "border": {
        "subtle": "#14FFFFFF",
        "default": "#1FFFFFFF",
        "strong": "#29FFFFFF",
        "focus": "#FF6B4A"
      },
      "status": {
        "danger": "#E5484D",
        "warning": "#E5A03C",
        "success": "#5AD0BE"
      }
    },
    "radius": {
      "sm": 6,
      "md": 8,
      "lg": 16,
      "full": 999
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24
    },
    "typography": {
      "scale": 1,
      "bodyWeight": 400,
      "titleWeight": 600
    },
    "elevation": {
      "sm": 1,
      "md": 3,
      "lg": 6
    },
    "effects": {
      "blur": 0,
      "glassOpacity": 1
    },
    "background": {
      "image": null,
      "fillMode": "cover",
      "overlay": null,
      "overlayOpacity": 0
    },
    "components": {
      "navBar": {
        "background": "#15171B",
        "gradient": {
          "stops": [
            { "color": "#1A1D21", "offset": 0 },
            { "color": "#15171B", "offset": 1 }
          ]
        },
        "selectedItem": "#FF8570",
        "selectedIndicator": "#26FF6B4A"
      },
      "playerBar": {
        "background": "#15171B",
        "gradient": {
          "stops": [
            { "color": "#15171B", "offset": 0 },
            { "color": "#0E0F12", "offset": 1 }
          ]
        },
        "progressTrack": "#1FFFFFFF",
        "progressActive": "#FF6B4A"
      },
      "lyric": {
        "activeLine": "#FF6B4A",
        "inactiveLine": "#A9AEB6",
        "activeBackground": "#1FFF6B4A"
      },
      "card": {
        "surface": "#1A1D21",
        "hover": "#22262B",
        "selected": "#2E211D"
      },
      "list": {
        "itemSelected": "#2E211D",
        "itemHover": "#22262B"
      },
      "motion": {
        "shortDurationMs": 150,
        "mediumDurationMs": 300,
        "curve": "standard"
      }
    }
  },
  "settings": [
    {
      "key": "brandColor",
      "type": "color",
      "label": "强调色",
      "default": "#FF6B4A",
      "target": "color.brand.base"
    },
    {
      "key": "cornerRadius",
      "type": "range",
      "label": "圆角",
      "min": 0,
      "max": 28,
      "default": 8,
      "target": "radius.md"
    }
  ],
  "assets": {},
  "layout": {
      "desktop": {
        "arrangement": [
          { "region": "topBar", "slot": "top", "size": 0.06 },
          { "region": "navBar", "slot": "left", "size": 0.14 },
          { "region": "content", "slot": "center" },
          { "region": "playerBar", "slot": "bottom", "size": 0.09 },
          { "region": "queue", "slot": "right", "size": 0.24 }
        ]
      },
    "mobile": {
      "arrangement": [
        { "region": "content", "slot": "center" },
        { "region": "playerBar", "slot": "bottom", "size": 0.09 },
        { "region": "navBar", "slot": "bottom", "size": 0.09 }
      ]
    },
    "content": {
      "listStyle": "list",
      "density": "regular"
    }
  }
}
